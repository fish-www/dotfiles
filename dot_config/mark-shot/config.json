{
    "annotation": {
        "defaultColor": "#FF4D4D",
        "defaultTool": "rectangle",
        "fileDefaultTool": "rectangle",
        "fullscreenDefaultTool": "rectangle"
    },
    "capture": {
        "freezeScope": "all-screens",
        "hideOwnWindows": true,
        "includeCursor": false,
        "wayland": {
            "kde": {
                "kwinScreenshot": {
                    "enabled": true
                }
            }
        }
    },
    "clipboard": {
        "image": {
            "mode": "image/png",
            "thresholdM": 4
        }
    },
    "codeScan": {
        "command": "",
        "provider": "auto",
        "timeoutMs": 15000
    },
    "debug": {
        "enabled": false,
        "logPath": "/tmp/mark-shot-scroll.log"
    },
    "env": {
    },
    "export": {
        "imageFrame": {
            "cornerRadius": 18,
            "enabled": false,
            "padding": 112,
            "shadowOffsetY": 28,
            "shadowOpacity": 0.32,
            "shadowRadius": 72
        }
    },
    "globalHotkeys": {
        "capture": "Ctrl+Alt+S",
        "enabled": true,
        "fullscreen": ""
    },
    "ocr": {
        "backend": "rapidocr",
        "command": "",
        "enabled": true,
        "provider": "auto",
        "resultPanel": true,
        "timeoutMs": 30000
    },
    "pinnedWindow": {
        "alwaysOnTop": true,
        "autoOcr": false,
        "border": true,
        "borderColor": "#5EEAD4",
        "borderEnabled": true,
        "borderWidth": 2,
        "textSelectionCopyEnabled": true
    },
    "recording": {
        "storage": {
            "gifDirectory": "~/Pictures/mark-shot/gifs",
            "videoDirectory": "~/Pictures/mark-shot/videos"
        }
    },
    "save": {
        "pathTemplate": "{pictures}/mark-shot/mark-shot-{datetime}.png"
    },
    "scrollCapture": {
        "frame": 5,
        "frameEnabled": true,
        "frameGap": 5,
        "hidePreviewDuringCapture": false,
        "previewGap": 5
    },
    "shortcuts": {
        "actions": {
            "cancel": "Esc",
            "clear": "",
            "copy": "Ctrl+C",
            "extensions": "",
            "ocrCopy": "",
            "openWith": "",
            "pin": "Ctrl+P",
            "redo": "Ctrl+Y",
            "save": "Ctrl+S",
            "scrollCapture": "",
            "settings": "",
            "toggleCaptureScope": "F",
            "toggleToolbarLayout": "",
            "undo": "Ctrl+Z",
            "upload": "Ctrl+U"
        },
        "startup": {
            "codeScanner": "Q",
            "colorPicker": "C",
            "displayCapture": "D",
            "gifRecorder": "G",
            "ruler": "R",
            "videoRecorder": "V"
        },
        "tools": {
            "arrow": "A",
            "ellipse": "E",
            "highlighter": "H",
            "laser": "G",
            "line": "L",
            "magnifier": "Z",
            "mosaic": "M",
            "move": "V",
            "number": "N",
            "pen": "P",
            "rectangle": "R",
            "select": "S",
            "text": "T"
        }
    },
    "startup": {
        "launchOnStartup": false
    },
    "toolbar": {
        "fontSize": 11,
        "iconSize": 22
    },
    "translation": {
        "apiBase": "https://api.openai.com/v1",
        "apiKey": "",
        "apiKeyEnv": "OPENAI_API_KEY",
        "autoAfterOcr": false,
        "command": "",
        "model": "gpt-4o-mini",
        "provider": "auto",
        "systemPrompt": "",
        "targetLanguage": "Simplified Chinese",
        "temperature": 0.2,
        "timeoutMs": 60000,
        "timeoutSeconds": 60
    },
    "ui": {
        "language": "chinese",
        "theme": "dark"
    },
    "upload": {
        "command": "",
        "env": {
        },
        "timeoutMs": 30000
    },
    "windowDetection": {
        "command": "mark-shot-window-detection-niri",
        "enabled": true,
        "env": {
        },
        "timeoutMs": 1000,
        "workingDirectory": ""
    },
    "windows": {
        "hotkeys": {
            "capture": "Ctrl+Alt+S",
            "enabled": true,
            "fullscreen": ""
        },
        "tray": {
            "autoStart": false,
            "enabled": false
        }
    }
}

